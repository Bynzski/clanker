{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "entry": [
    "src/renderer/main.tsx",
    "src/renderer/index.html",
    "src/renderer/electron.d.ts",
    "src/shared/types/credentials.ts",
    "scripts/app-close-guard-smoke.cjs",
    "scripts/pi-bridge-smoke.cjs",
    "scripts/ssh-preview-session-smoke.cjs",
    "scripts/terminal-geometry-smoke.cjs",
    "scripts/workspace-pages-smoke.cjs",
    "scripts/workspace-launch-race-smoke.cjs"
  ],
  "ignoreDependencies": ["@modelcontextprotocol/sdk", "node:sqlite"],
  "overrides": [
    {
      "files": ["src/renderer/electron.d.ts"],
